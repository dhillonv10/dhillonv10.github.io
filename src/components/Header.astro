---
import { SITE } from "@config";
import BugMark from "./BugMark.astro";

export interface Props {
  activeNav?: "essays" | "notes" | "library" | "about" | "search";
}

const { activeNav } = Astro.props;
const inGarden =
  activeNav === "essays" || activeNav === "notes" || activeNav === "library";
---

<header class="site-header">
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="site-header-inner">
    <a href="/" class="brand" aria-label={`${SITE.brand} home`}>
      <BugMark />
      <span class="brand-name">{SITE.brand}</span>
    </a>

    <button
      class="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7" class="bars"></line>
        <line x1="4" y1="12" x2="20" y2="12" class="bars"></line>
        <line x1="4" y1="17" x2="20" y2="17" class="bars"></line>
        <line x1="6" y1="6" x2="18" y2="18" class="cross"></line>
        <line x1="18" y1="6" x2="6" y2="18" class="cross"></line>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <div class="nav-group">
        <button
          class={`nav-link nav-group-btn ${inGarden ? "active" : ""}`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          The Garden
          <svg
            class="chev"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="nav-menu">
          <a href="/essays/" class={activeNav === "essays" ? "active" : ""}>
            <strong>Essays</strong>
            <span>Longer pieces with a point of view</span>
          </a>
          <a href="/notes/" class={activeNav === "notes" ? "active" : ""}>
            <strong>Notes</strong>
            <span>Shorter, looser, still growing</span>
          </a>
          <a href="/library/" class={activeNav === "library" ? "active" : ""}>
            <strong>Library</strong>
            <span>Books I've read and mean to read</span>
          </a>
        </div>
      </div>
      <a
        href="/about/"
        class={`nav-link ${activeNav === "about" ? "active" : ""}`}
      >
        About
      </a>
      <a
        href="/search/"
        class={`nav-icon ${activeNav === "search" ? "active" : ""}`}
        aria-label="Search"
        title="Search"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
          ></path></svg
        >
      </a>
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="nav-icon"
            title="Toggles light & dark"
            aria-label="auto"
            aria-live="polite"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              id="moon-svg"
              viewBox="0 0 24 24"
            >
              <path d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-2.135 0-4.14-.83-5.646-2.336a8.025 8.025 0 0 1-2.064-7.723A1 1 0 0 0 9.73 2.034a10.014 10.014 0 0 0-4.489 2.582c-3.898 3.898-3.898 10.243 0 14.143a9.937 9.937 0 0 0 7.072 2.93 9.93 9.93 0 0 0 7.07-2.929 10.007 10.007 0 0 0 2.583-4.491 1.001 1.001 0 0 0-1.224-1.224zm-2.772 4.301a7.947 7.947 0 0 1-5.656 2.343 7.953 7.953 0 0 1-5.658-2.344c-3.118-3.119-3.118-8.195 0-11.314a7.923 7.923 0 0 1 2.06-1.483 10.027 10.027 0 0 0 2.89 7.848 9.972 9.972 0 0 0 7.848 2.891 8.036 8.036 0 0 1-1.484 2.059z" />
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              id="sun-svg"
              viewBox="0 0 24 24"
            >
              <path d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12zM12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993zM10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z" />
            </svg>
          </button>
        )
      }
    </nav>
  </div>
</header>

<script>
  function setupHeader() {
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const nav = document.getElementById("site-nav");
    const group = document.querySelector<HTMLElement>(".nav-group");
    const groupBtn = group?.querySelector<HTMLButtonElement>(".nav-group-btn");

    toggle?.addEventListener("click", () => {
      const open = nav?.classList.toggle("open") ?? false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.classList.toggle("is-open", open);
    });

    // The Garden menu opens on hover/focus via CSS; this adds tap and Esc support.
    groupBtn?.addEventListener("click", e => {
      e.stopPropagation();
      const open = group?.classList.toggle("open") ?? false;
      groupBtn.setAttribute("aria-expanded", String(open));
    });
    const close = () => {
      group?.classList.remove("open");
      groupBtn?.setAttribute("aria-expanded", "false");
    };
    document.addEventListener("click", e => {
      if (!(e.target as Element).closest(".nav-group")) close();
    });
    document.addEventListener("keydown", e => {
      if (e.key === "Escape") close();
    });
  }
  setupHeader();
  document.addEventListener("astro:after-swap", setupHeader);
</script>
