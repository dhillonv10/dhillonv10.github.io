---
// Growth-stage icons: seedling, budding, evergreen. Simple strokes, own design.
export interface Props {
  stage?: "seedling" | "budding" | "evergreen";
  class?: string;
}
const { stage = "budding", class: className = "" } = Astro.props;
const label = {
  seedling: "Seedling",
  budding: "Budding",
  evergreen: "Evergreen",
}[stage];
---

<svg
  class={`stage-icon ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
>
  <title>{label}</title>
  {
    stage === "seedling" && (
      <>
        <path d="M12 21v-8" />
        <path d="M12 13c0-3.5-2.5-5-6-5 0 3.5 2.5 5 6 5z" />
        <path d="M12 13c0-3 2-4.5 5-4.5 0 3-2 4.5-5 4.5z" />
      </>
    )
  }
  {
    stage === "budding" && (
      <>
        <path d="M12 21V9" />
        <path d="M12 15c0-3.5-2.5-5-6-5 0 3.5 2.5 5 6 5z" />
        <path d="M12 12c0-3 2-4.5 5-4.5 0 3-2 4.5-5 4.5z" />
        <path d="M12 9c0-2.5 1-4.5 3-6 1 2.5 0 5-3 6z" />
      </>
    )
  }
  {
    stage === "evergreen" && (
      <>
        <path d="M12 22v-4" />
        <path d="m12 3-5 7h3l-5 6h14l-5-6h3z" />
      </>
    )
  }
</svg>
