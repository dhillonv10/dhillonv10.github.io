---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Comments from "@components/Comments.astro";
import StageIcon from "@components/StageIcon.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@utils/getSortedPosts";
import readingTime from "@utils/readingTime";
import inlineMd from "@utils/inlineMd";
import formatDate from "@utils/formatDate";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import { SITE } from "@config";
import "@styles/lw.css";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  subtitle,
  takeaways,
  audience,
  stage,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = post.data;

// Featured posts are essays; everything else is a note.
const isEssay = Boolean(post.data.featured);
const kindLabel = isEssay ? "Essays" : "Notes";
const kindHref = isEssay ? "/essays/" : "/notes/";
const stageLabel = {
  seedling: "Seedling",
  budding: "Budding",
  evergreen: "Evergreen",
}[stage];

const { Content, headings } = await post.render();
const minutes = readingTime(post.body);
const tocItems = headings.filter(
  h => (h.depth === 2 || h.depth === 3) && h.slug !== "footnote-label"
);

// Neighbours within the same kind (newest first):
// "next" is the newer post, "previous" the older one.
const sameKind = getSortedPosts(await getCollection("blog")).filter(
  p => Boolean(p.data.featured) === isEssay
);
const idx = sameKind.findIndex(p => p.slug === post.slug);
const newer = idx > 0 ? sameKind[idx - 1] : undefined;
const older = idx >= 0 ? sameKind[idx + 1] : undefined;

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header activeNav={isEssay ? "essays" : "notes"} />

  <aside class="toc-rail" id="toc-rail" aria-label="Table of contents">
    <button
      type="button"
      class="toc-label"
      id="toc-label"
      aria-expanded="false"
      aria-controls="toc-panel"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 6h16M4 12h10M4 18h13"></path>
      </svg>
      <span>Table of Contents</span>
    </button>
    <ol class="toc-ticks" aria-hidden="true">
      {
        tocItems.map(h => (
          <li class={`t${h.depth}`}>
            <a href={`#${h.slug}`} tabindex="-1" data-target={h.slug}>
              <i />
            </a>
          </li>
        ))
      }
      <li class="t2">
        <a href="#comments" tabindex="-1" data-target="comments"><i></i></a>
      </li>
    </ol>
    <nav class="toc-panel" id="toc-panel" aria-label="Contents">
      <a href="#top" class="toc-title">{title}</a>
      <ul>
        {
          tocItems.map(h => (
            <li class={`lvl-${h.depth}`}>
              <a href={`#${h.slug}`} data-target={h.slug}>
                {h.text}
              </a>
            </li>
          ))
        }
        <li class="lvl-2">
          <a href="#comments" data-target="comments">Comments</a>
        </li>
      </ul>
    </nav>
  </aside>

  <div class="lw-layout">
    <main
      id="main-content"
      class={`lw-post ${isEssay ? "is-essay" : "is-note"}`}
    >
      <span id="top"></span>

      <header class="post-head">
        <p class="post-kicker">
          <a href={kindHref}>{kindLabel}</a>
          <StageIcon stage={stage} />
          <span class="stage">{stageLabel}</span>
        </p>
        <h1 transition:name={slugifyStr(title)} class="lw-post-title">
          {title}
        </h1>
        {subtitle && <p class="lw-subtitle">{subtitle}</p>}
        <div class="lw-byline">
          <div class="by">
            <b>{author}</b>
            <span>{minutes} min read</span>
            <a href="#comments">Comments</a>
          </div>
          <div class="dates">
            <span>
              Planted <time datetime={new Date(pubDatetime).toISOString()}
                >{formatDate(pubDatetime)}</time
              >
            </span>
            <span>
              Last tended <time
                datetime={new Date(modDatetime ?? pubDatetime).toISOString()}
                >{formatDate(modDatetime ?? pubDatetime)}</time
              >
            </span>
          </div>
        </div>
      </header>

      {
        audience && (
          <aside class="lw-audience" aria-label="Who this is for">
            <span class="label">Written for</span>
            <p>{audience}</p>
          </aside>
        )
      }

      {
        takeaways && takeaways.length > 0 && (
          <aside class="lw-takeaways" aria-label="Key takeaways">
            <h2>Key takeaways</h2>
            <ul>
              {takeaways.map(t => (
                <li set:html={inlineMd(t)} />
              ))}
            </ul>
          </aside>
        )
      }

      <article id="article" role="article" class="lw-post-body">
        <Content />
      </article>

      <div
        class="mt-8 flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4"
      >
        <ShareLinks />
      </div>

      {
        (older || newer) && (
          <nav class="lw-pager" aria-label="More posts">
            {older && (
              <a class="prev" href={`/posts/${older.slug}/`} rel="prev">
                <span class="dir">← Previous {isEssay ? "essay" : "note"}</span>
                <span class="ttl">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a class="next" href={`/posts/${newer.slug}/`} rel="next">
                <span class="dir">Next {isEssay ? "essay" : "note"} →</span>
                <span class="ttl">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      <Comments />
    </main>
  </div>
  <button
    type="button"
    id="lw-top"
    class="lw-top"
    aria-label="Back to top"
    title="Back to top"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M6 15l6-6 6 6"></path></svg
    >
  </button>
  <Footer />
</Layout>

<script is:inline>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-skin-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    const winScroll =
      document.body.scrollTop || document.documentElement.scrollTop;
    const height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    if (document) {
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = scrolled + "%";
      }
    }
  }
  document.addEventListener("scroll", updateScrollProgress);

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    let headings = Array.from(
      document.querySelectorAll(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      )
    );
    for (let heading of headings) {
      heading.classList.add("group");
      let link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link hidden group-hover:inline-block ml-2";
      link.href = "#" + heading.id;
      link.ariaHidden = "true";
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    let copyButtonLabel = "Copy";
    let codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (let codeBlock of codeBlocks) {
      let wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      let copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      let code = block.querySelector("code");
      let text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /** Contents rail: highlight the current section, and open the full list on
   *  hover (CSS), focus, or tap. On small screens it is a "Contents" pill. */
  function setupToc() {
    const rail = document.getElementById("toc-rail");
    const label = document.getElementById("toc-label");
    if (!rail || !label) return;
    const links = Array.from(rail.querySelectorAll("a[data-target]"));
    const ids = Array.from(new Set(links.map(a => a.dataset.target)));
    const targets = ids.map(id => document.getElementById(id)).filter(Boolean);

    function update() {
      let current = null;
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= 140) current = el.id;
      }
      links.forEach(a =>
        a.classList.toggle("active", a.dataset.target === current)
      );
    }
    document.addEventListener("scroll", update, { passive: true });
    update();

    const setOpen = open => {
      rail.classList.toggle("open", open);
      label.setAttribute("aria-expanded", String(open));
    };
    label.addEventListener("click", e => {
      e.stopPropagation();
      setOpen(!rail.classList.contains("open"));
    });
    rail
      .querySelectorAll(".toc-panel a")
      .forEach(a => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("click", e => {
      if (!e.target.closest("#toc-rail")) setOpen(false);
    });
    document.addEventListener("keydown", e => {
      if (e.key === "Escape") setOpen(false);
    });
  }
  setupToc();

  /** Sidenotes: turn each markdown footnote into a note that sits in the right
   *  margin beside the line that cites it (wide screens) or opens inline when you
   *  tap its number (narrow screens). Without JavaScript the footnotes stay at
   *  the bottom of the page. */
  function setupSidenotes() {
    const article = document.getElementById("article");
    if (!article) return;
    const refs = Array.from(
      article.querySelectorAll("sup > a[data-footnote-ref]")
    );
    let converted = 0;
    refs.forEach((ref, i) => {
      const id = decodeURIComponent((ref.getAttribute("href") || "").slice(1));
      const li = id && document.getElementById(id);
      const sup = ref.parentElement;
      if (!li || !sup) return;

      const note = document.createElement("span");
      note.className = "sidenote";
      note.innerHTML = li.innerHTML;
      note
        .querySelectorAll("a[data-footnote-backref]")
        .forEach(a => a.remove());
      // flatten paragraphs so the note can live inside a paragraph
      note.querySelectorAll("p").forEach(p => {
        const span = document.createElement("span");
        span.className = "sn-p";
        span.innerHTML = p.innerHTML;
        p.replaceWith(span);
      });

      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.className = "sn-toggle";
      cb.id = "sn-" + (i + 1);
      const label = document.createElement("label");
      label.className = "sn-num";
      label.htmlFor = cb.id;
      label.setAttribute("role", "button");
      label.setAttribute("aria-label", "Show note " + (i + 1));

      const wrap = document.createElement("span");
      wrap.className = "sn-container";
      wrap.append(label, cb, note);
      sup.replaceWith(wrap);
      converted++;
    });
    if (converted) article.classList.add("has-sidenotes");
  }
  setupSidenotes();

  /** Turn each standalone figure's alt text into a caption. */
  function addCaptions() {
    document.querySelectorAll("#article p > img:only-child").forEach(img => {
      const alt = img.getAttribute("alt");
      const p = img.parentElement;
      if (!alt || !p || p.querySelector("figcaption")) return;
      p.classList.add("lw-figure");
      const cap = document.createElement("span");
      cap.className = "lw-caption";
      cap.textContent = alt;
      p.appendChild(cap);
    });
  }
  addCaptions();

  /** Click a figure to view it full size; click or Esc to close. */
  function setupLightbox() {
    document.querySelectorAll("#article .lw-figure img").forEach(img => {
      img.addEventListener("click", () => {
        const box = document.createElement("div");
        box.className = "lw-lightbox";
        const big = document.createElement("img");
        big.src = img.src; // full-size file, not the smaller srcset variant
        big.alt = img.alt;
        box.appendChild(big);
        const close = () => {
          box.remove();
          document.removeEventListener("keydown", onKey);
        };
        const onKey = e => e.key === "Escape" && close();
        box.addEventListener("click", close);
        document.addEventListener("keydown", onKey);
        document.body.appendChild(box);
      });
    });
  }
  setupLightbox();

  /** Floating back-to-top button: appears once you've scrolled a screen or so. */
  function setupFloatingTop() {
    const btn = document.getElementById("lw-top");
    if (!btn) return;
    const update = () =>
      btn.classList.toggle("show", window.scrollY > window.innerHeight * 0.8);
    document.addEventListener("scroll", update, { passive: true });
    btn.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" })
    );
    update();
  }
  setupFloatingTop();
</script>
