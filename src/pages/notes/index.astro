---
import { getCollection } from "astro:content";
import GardenIndex from "@layouts/GardenIndex.astro";
import StageIcon from "@components/StageIcon.astro";
import getSortedPosts from "@utils/getSortedPosts";
import formatDate from "@utils/formatDate";

const notes = getSortedPosts(await getCollection("blog")).filter(
  ({ data }) => !data.featured
);
---

<GardenIndex
  title="Notes"
  description="Shorter, looser notes on things I'm still figuring out."
  active="notes"
>
  <ul class="note-list note-list--wide">
    {
      notes.map(post => (
        <li class="note-item">
          <a href={`/posts/${post.slug}/`}>
            <StageIcon stage={post.data.stage} />
            <span class="note-main">
              <span class="note-title">{post.data.title}</span>
              <span class="note-desc">{post.data.description}</span>
            </span>
            <time datetime={new Date(post.data.pubDatetime).toISOString()}>
              {formatDate(post.data.pubDatetime)}
            </time>
          </a>
        </li>
      ))
    }
  </ul>
</GardenIndex>
