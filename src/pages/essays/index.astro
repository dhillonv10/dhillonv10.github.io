---
import { getCollection } from "astro:content";
import GardenIndex from "@layouts/GardenIndex.astro";
import EssayCard from "@components/EssayCard.astro";
import getSortedPosts from "@utils/getSortedPosts";

const essays = getSortedPosts(await getCollection("blog")).filter(
  ({ data }) => data.featured
);
---

<GardenIndex
  title="Essays"
  description="Longer pieces with a point of view."
  active="essays"
>
  <div class="essay-grid essay-grid--wide">
    {essays.map(post => <EssayCard post={post} />)}
  </div>
</GardenIndex>
