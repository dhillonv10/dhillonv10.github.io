---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SiteNav from "@components/SiteNav.astro";
import getSortedPosts from "@utils/getSortedPosts";
import readingTime from "@utils/readingTime";
import { slugifyStr } from "@utils/slugify";
import { SITE } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);

const feeds = [
  { id: "recent", label: "Recent", items: sortedPosts.slice(0, 20) },
  { id: "featured", label: "Featured", items: featuredPosts },
].filter(f => f.items.length > 0);
---

<Layout>
  <Header />
  <div class="lw-shell">
    <SiteNav active="home" posts={posts} />
    <main id="main-content" class="lw-feed">
      <p class="lw-intro">
        Notes and essays by {SITE.author}. {SITE.desc}.
      </p>

      <div class="lw-tabs" role="tablist">
        {
          feeds.map((f, i) => (
            <button
              class="lw-tab"
              role="tab"
              data-feed={f.id}
              aria-selected={i === 0 ? "true" : "false"}
            >
              {f.label}
            </button>
          ))
        }
      </div>

      {
        feeds.map((f, i) => (
          <ul class="lw-list" data-feed-list={f.id} hidden={i !== 0}>
            {f.items.map(({ data, slug, body }) => (
              <li class="lw-item">
                <div class="lw-score" title="Estimated reading time">
                  <strong>{readingTime(body)}</strong>
                  <span>min</span>
                </div>
                <a class="lw-item-title" href={`/posts/${slug}/`}>
                  {data.title}
                </a>
                <span class="lw-item-meta">
                  {data.author} ·{" "}
                  <time
                    class="js-age"
                    datetime={new Date(
                      data.modDatetime ?? data.pubDatetime
                    ).toISOString()}
                  >
                    {new Date(data.pubDatetime).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                      timeZone: "UTC",
                    })}
                  </time>
                </span>
                <div class="lw-item-sub">
                  {data.tags.map(t => (
                    <a class="lw-chip" href={`/tags/${slugifyStr(t)}/`}>
                      {t}
                    </a>
                  ))}
                  {data.description}
                </div>
              </li>
            ))}
          </ul>
        ))
      }

      <a class="lw-more" href="/posts/">All posts →</a>
    </main>
  </div>
  <Footer />
</Layout>

<script>
  function setup() {
    const tabs = document.querySelectorAll<HTMLElement>(".lw-tab");
    tabs.forEach(tab =>
      tab.addEventListener("click", () => {
        tabs.forEach(t => t.setAttribute("aria-selected", String(t === tab)));
        document
          .querySelectorAll<HTMLElement>("[data-feed-list]")
          .forEach(l => (l.hidden = l.dataset.feedList !== tab.dataset.feed));
      })
    );
    // Show compact relative ages (2d, 3mo) like a forum feed.
    document.querySelectorAll<HTMLTimeElement>("time.js-age").forEach(el => {
      const days = Math.floor(
        (Date.now() - new Date(el.dateTime).getTime()) / 864e5
      );
      if (days < 0) return;
      el.title = el.textContent ?? "";
      el.textContent =
        days < 1
          ? "today"
          : days < 30
            ? `${days}d`
            : days < 365
              ? `${Math.floor(days / 30)}mo`
              : `${Math.floor(days / 365)}y`;
    });
  }
  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
