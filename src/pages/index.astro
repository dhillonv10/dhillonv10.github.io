---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import EssayCard from "@components/EssayCard.astro";
import NoteItem from "@components/NoteItem.astro";
import BookCard from "@components/BookCard.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { BOOKS } from "@data/books";
import { SITE } from "@config";

const posts = getSortedPosts(await getCollection("blog"));
const essays = posts.filter(({ data }) => data.featured);
const notes = posts.filter(({ data }) => !data.featured).slice(0, 12);
---

<Layout>
  <Header />
  <main id="main-content" class="home">
    <section class="hero">
      <h1>
        <strong>Vik</strong> looks for the bugs in medicine, AI, and the way the
        world runs.
      </h1>
      <p class="hero-sub">Physician, author, researcher.</p>
      <p class="hero-sub">
        {SITE.brand} is a notebook of essays and notes, <a href="/about/"
          >named for a bug worth finding</a
        >.
      </p>
    </section>

    <section class="garden">
      <div class="garden-head">
        <h2>The Garden</h2>
        <p>Essays and notes, some finished and most still growing.</p>
      </div>

      <div class="garden-grid">
        <section class="essays" aria-labelledby="essays-title">
          <h3 id="essays-title" class="section-title">
            <a href="/essays/">Essays <span aria-hidden="true">→</span></a>
          </h3>
          <p class="section-desc">Longer pieces with a point of view.</p>
          <div class="essay-grid">
            {essays.map(post => <EssayCard post={post} />)}
          </div>
        </section>

        <section class="notes" aria-labelledby="notes-title">
          <h3 id="notes-title" class="section-title">
            <a href="/notes/">Notes <span aria-hidden="true">→</span></a>
          </h3>
          <p class="section-desc">
            Shorter, looser notes on things I'm still figuring out.
          </p>
          <ul class="note-list">
            {notes.map(post => <NoteItem post={post} />)}
          </ul>
        </section>
      </div>

      <section class="library" aria-labelledby="library-title">
        <h3 id="library-title" class="section-title">
          <a href="/library/">Library <span aria-hidden="true">→</span></a>
        </h3>
        <p class="section-desc">Books I've read and books I mean to.</p>
        <div class="book-grid">
          {BOOKS.map(book => <BookCard book={book} />)}
        </div>
      </section>
    </section>
  </main>
  <Footer />
</Layout>
